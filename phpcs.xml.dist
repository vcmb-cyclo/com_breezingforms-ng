<?xml version="1.0"?>
<ruleset name="BreezingFormsNG">
    <description>PSR-12 coding standard for BreezingForms NG (Joomla 6 / PHP 8.3).</description>

    <file>administrator/components/com_breezingformsng/src/Service/AjaxStateService.php</file>
    <file>administrator/components/com_breezingformsng/src/Service/DatabaseAuditService.php</file>
    <file>components/com_breezingformsng/src/Service/Runtime</file>
    <file>components/com_breezingformsng/src/Service/Upload</file>
    <file>components/com_breezingformsng/src/Service/Rendering/JavascriptCompressor.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/JavascriptValueExporter.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ProcessorHeaderRenderer.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderValueScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderReadonlyScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderSignatureScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderFileUploadScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/EditableRecord.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/EditableRecordLoader.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/PostRenderScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderTechnicalFieldsBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderFlashUploadValidationBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/ContentBuilderEditableRecordScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickModeRendererFactory.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/FormOnloadScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QueryListRowPreparationService.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QueryListPageScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/CallbackRegistrationService.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/HiddenFieldTrait.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/BootstrapStyleFieldTrait.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeInputBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeTextareaBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCheckboxBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeSelectBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeMaxLengthCounterBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeGroupOptionBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeSubmitButtonBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCalendarButtonBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCalendarInputBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCalendarInitScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCaptchaUrlBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCaptchaMarkupBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeCaptchaReloadScriptBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeUploadOptionsBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModePagingActionBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeSubmitActionBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeHiddenFieldBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeFileInputBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModePaymentButtonBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Rendering/QuickMode/QuickModeSignatureMarkupBuilder.php</file>
    <file>components/com_breezingformsng/src/Service/Callback/CaptchaCallback.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>

    <!--
        Legacy runtime surfaces are intentionally excluded until they are
        decomposed. Removing an entry is part of the corresponding refactor.
    -->
    <exclude-pattern>components/com_breezingformsng/src/Service/Runtime/CodeToolsRuntime.php</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Joomla extension entry points intentionally combine the class symbol
         with the native direct-access guard. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <severity>0</severity>
    </rule>

    <!-- Joomla task names are part of the public controller routing contract. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/Controller/*</exclude-pattern>
    </rule>

    <!-- Joomla installer discovers this global class by its fixed name. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>script.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>script.php</exclude-pattern>
    </rule>
</ruleset>
