<extension type="component" version="6.0" method="upgrade">

	<name>COM_BREEZINGFORMSNG</name>
	<element>com_breezingformsng</element>
	<creationDate>2026-04-28</creationDate>
	<author>XDA/GIL</author>
	<copyright>Copyright 2004 - 2026 by XDA+GIL</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>bf@vcmb.fr</authorEmail>
	<authorUrl>https://breezingforms-ng.vcmb.fr</authorUrl>
	<version>6.0.8-RC6</version>
	<description>COM_BREEZINGFORMSNG_XML_DESCRIPTION</description>

	<namespace path="src">Vcmb\Component\BreezingformsNG</namespace>

	<scriptfile>script.php</scriptfile>

	<updateservers>
		<server type="extension" name="BreezingForms-ng" priority="1">https://breezingforms-ng.vcmb.fr/download/com_breezingformsng_update.xml</server>
	</updateservers>

	<targetplatform>
		<platform name="joomla" version="6.*" />
	</targetplatform>

	<files folder="components/com_breezingformsng">
		<filename>index.html</filename>
		<filename>breezingformsng.php</filename>
		<filename>facileforms.class.php</filename>
		<filename>facileforms.process.php</filename>
		<filename>facileforms.xml.php</filename>
		<filename>router.php</filename>
		<folder>downloadtpl</folder>
		<folder>exports</folder>
		<folder>libraries</folder>
		<folder>src</folder>
		<folder>themes</folder>
		<folder>uploads</folder>
	</files>

	<languages folder="components/com_breezingformsng">
		<language tag="de-DE">languages/de-DE/de-DE.com_breezingformsng.ini</language>
		<language tag="en-GB">languages/en-GB/en-GB.com_breezingformsng.ini</language>
		<language tag="es-ES">languages/es-ES/es-ES.com_breezingformsng.ini</language>
		<language tag="fr-FR">languages/fr-FR/fr-FR.com_breezingformsng.ini</language>
		<language tag="hu-HU">languages/hu-HU/hu-HU.com_breezingformsng.ini</language>
		<language tag="nl-NL">languages/nl-NL/nl-NL.com_breezingformsng.ini</language>
		<language tag="tr-TR">languages/tr-TR/tr-TR.com_breezingformsng.ini</language>
	</languages>

	<administration>
		<menu>COM_BREEZINGFORMSNG</menu>

		<submenu>
			<menu option="com_breezingformsng" act="managerecs" alt="BreezingForms/Manage Records">COM_BREEZINGFORMSNG_MANAGE_RECORDS</menu>

			<menu option="com_breezingformsng" act="manageforms" alt="BreezingForms/Manage Forms">
				COM_BREEZINGFORMSNG_MANAGE_FORMS
				<params>
					<menu-quicktask>index.php?option=com_breezingformsng&amp;act=manageforms&amp;task=quickmode</menu-quicktask>
					<menu-quicktask-title>COM_BREEZINGFORMSNG_MENUS_NEW_FORM</menu-quicktask-title>
					<menu-quicktask-icon>plus</menu-quicktask-icon>
				</params>
			</menu>

			<menu option="com_breezingformsng" act="managescripts" alt="BreezingForms/Manage Scripts">
				COM_BREEZINGFORMSNG_MANAGE_SCRIPTS
				<params>
					<menu-quicktask>index.php?option=com_breezingformsng&amp;act=managescripts&amp;task=new</menu-quicktask>
					<menu-quicktask-title>COM_BREEZINGFORMSNG_MENUS_NEW_SCRIPT</menu-quicktask-title>
					<menu-quicktask-icon>plus</menu-quicktask-icon>
				</params>
			</menu>

			<menu option="com_breezingformsng" act="managepieces" alt="BreezingForms/Manage Pieces">
				COM_BREEZINGFORMSNG_MANAGE_PIECES
				<params>
					<menu-quicktask>index.php?option=com_breezingformsng&amp;act=managepieces&amp;task=new</menu-quicktask>
					<menu-quicktask-title>COM_BREEZINGFORMSNG_MENUS_NEW_PIECE</menu-quicktask-title>
					<menu-quicktask-icon>plus</menu-quicktask-icon>
				</params>
			</menu>

			<menu option="com_breezingformsng" act="integrate" alt="BreezingForms/Integrator">
				COM_BREEZINGFORMSNG_INTEGRATOR
				<params>
					<menu-quicktask>index.php?option=com_breezingformsng&amp;act=integrate&amp;task=add</menu-quicktask>
					<menu-quicktask-title>COM_BREEZINGFORMSNG_MENUS_NEW_INTEGRATION</menu-quicktask-title>
					<menu-quicktask-icon>plus</menu-quicktask-icon>
				</params>
			</menu>

			<menu option="com_breezingformsng" act="configuration" alt="BreezingForms/Configuration">COM_BREEZINGFORMSNG_CONFIGURATION</menu>
			<menu option="com_breezingformsng" act="about" alt="BreezingForms/About">COM_BREEZINGFORMSNG_ABOUT</menu>
		</submenu>

		<files folder="administrator/components/com_breezingformsng">
			<filename>index.html</filename>
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<filename>joomla.asset.json</filename>
			<filename>admin.breezingforms.php</filename>
			<filename>toolbar.facileforms.html.php</filename>
			<filename>toolbar.facileforms.php</filename>

			<folder>admin</folder>
			<folder>ajax_cache</folder>
			<folder>images</folder>
			<folder>languages</folder>
			<folder>libraries</folder>
			<folder>mailtpl</folder>
			<folder>packages</folder>
			<folder>payment_cache</folder>
			<folder>pdftpl</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>plugins</folder>
		</files>

		<languages folder="administrator/components/com_breezingformsng">
			<language tag="de-DE">languages/de-DE/de-DE.com_breezingformsng.ini</language>
			<language tag="de-DE">languages/de-DE/de-DE.com_breezingformsng.sys.ini</language>

			<language tag="en-GB">languages/en-GB/en-GB.com_breezingformsng.ini</language>
			<language tag="en-GB">languages/en-GB/en-GB.com_breezingformsng.sys.ini</language>

			<language tag="es-ES">languages/es-ES/es-ES.com_breezingformsng.ini</language>
			<language tag="es-ES">languages/es-ES/es-ES.com_breezingformsng.sys.ini</language>

			<language tag="fr-FR">languages/fr-FR/fr-FR.com_breezingformsng.ini</language>
			<language tag="fr-FR">languages/fr-FR/fr-FR.com_breezingformsng.sys.ini</language>

			<language tag="hu-HU">languages/hu-HU/hu-HU.com_breezingformsng.ini</language>
			<language tag="hu-HU">languages/hu-HU/hu-HU.com_breezingformsng.sys.ini</language>

			<language tag="nl-NL">languages/nl-NL/nl-NL.com_breezingformsng.ini</language>
			<language tag="nl-NL">languages/nl-NL/nl-NL.com_breezingformsng.sys.ini</language>

			<language tag="tr-TR">languages/tr-TR/tr-TR.com_breezingformsng.ini</language>
			<language tag="tr-TR">languages/tr-TR/tr-TR.com_breezingformsng.sys.ini</language>
		</languages>

	</administration>

	<media folder="media/com_breezingformsng" destination="com_breezingformsng">
		<folder>css</folder>
		<folder>font-awesome</folder>
		<folder>images</folder>
		<folder>js</folder>
	</media>

</extension>
