{
    "name": "vcmb/com_breezingformsng-dev",
    "description": "Dev tooling (PHPUnit) for com_breezingformsng - not part of the installable Joomla package",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Vcmb\\Component\\BreezingformsNG\\Administrator\\": "administrator/components/com_breezingformsng/src/",
